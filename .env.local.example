# ===== Supabase (lấy ở Supabase → Project Settings → API) =====
# Sao chép file này thành .env.local rồi điền giá trị thật.
# .env.local đã được .gitignore -> KHÔNG bị đẩy lên GitHub.

# Project URL (dạng https://xxxxx.supabase.co)
SUPABASE_URL=

# service_role key — BÍ MẬT, chỉ dùng phía server. KHÔNG đặt tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
