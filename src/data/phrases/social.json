  { "id": "soc-066", "topicId": "social", "en": "It's really hot today.", "vi": "Hôm nay nóng thật đấy.", "highlights": ["really hot"], "note": "Small talk về thời tiết nóng.", "tags": ["small talk"] },
  { "id": "soc-067", "topicId": "social", "en": "It looks like rain.", "vi": "Trông như sắp mưa.", "highlights": ["looks like rain"], "note": "Dự đoán thời tiết, mở đầu trò chuyện.", "tags": ["small talk"] },
  { "id": "soc-068", "topicId": "social", "en": "Did you sleep well?", "vi": "Bạn ngủ ngon không?", "highlights": ["sleep well"], "note": "Hỏi thăm buổi sáng.", "tags": ["small talk"] },
  { "id": "soc-069", "topicId": "social", "en": "Have a good weekend!", "vi": "Chúc cuối tuần vui nhé!", "highlights": ["good weekend"], "note": "Lời chúc trước cuối tuần.", "tags": ["greeting"] },
  { "id": "soc-070", "topicId": "social", "en": "See you on Monday.", "vi": "Hẹn gặp thứ Hai.", "highlights": ["See you on Monday"], "note": "Tạm biệt cuối tuần.", "tags": ["greeting"] },
  { "id": "soc-071", "topicId": "social", "en": "Text me when you get home.", "vi": "Về tới nhà thì nhắn tôi nhé.", "highlights": ["when you get home"], "note": "Quan tâm khi ai đó về.", "tags": ["greeting"] },
  { "id": "soc-072", "topicId": "social", "en": "Let's hang out sometime.", "vi": "Khi nào mình đi chơi nhé.", "highlights": ["hang out"], "note": "'hang out' = đi chơi/tụ tập thân mật.", "tags": ["invitation"] },
  { "id": "soc-073", "topicId": "social", "en": "Are you free this weekend?", "vi": "Cuối tuần này bạn rảnh không?", "highlights": ["free this weekend"], "note": "Hỏi lịch để rủ đi chơi.", "tags": ["invitation"] },
  { "id": "soc-074", "topicId": "social", "en": "Do you want to join us?", "vi": "Bạn muốn tham gia với tụi mình không?", "highlights": ["join us"], "note": "Mời ai đó nhập hội.", "tags": ["invitation"] },
  { "id": "soc-075", "topicId": "social", "en": "I think I'll pass this time.", "vi": "Lần này chắc tôi xin kiếu.", "highlights": ["I'll pass"], "note": "'pass' = bỏ qua/không tham gia, lịch sự.", "tags": ["invitation"] },
  { "id": "soc-076", "topicId": "social", "en": "That'd be great.", "vi": "Vậy thì tuyệt.", "highlights": ["That'd be great"], "note": "Hưởng ứng một đề nghị.", "tags": ["invitation"] },
  { "id": "soc-077", "topicId": "social", "en": "Can't wait!", "vi": "Nóng lòng quá đi!", "highlights": ["Can't wait"], "note": "Thể hiện háo hức chờ đợi sự kiện.", "tags": ["invitation"] },
  { "id": "soc-078", "topicId": "social", "en": "It was great seeing you.", "vi": "Rất vui được gặp bạn.", "highlights": ["great seeing you"], "note": "Câu chia tay sau khi gặp mặt.", "tags": ["greeting"] },
  { "id": "soc-079", "topicId": "social", "en": "Say hi to your family.", "vi": "Cho tôi gửi lời chào gia đình bạn nhé.", "highlights": ["Say hi to"], "note": "Lời nhắn lịch sự khi chia tay.", "tags": ["greeting"] },
  { "id": "soc-080", "topicId": "social", "en": "Take it easy.", "vi": "Cứ thong thả/giữ sức nhé.", "highlights": ["Take it easy"], "note": "Lời chào thư giãn, cũng nghĩa 'bình tĩnh'.", "tags": ["greeting"] },
  { "id": "soc-081", "topicId": "social", "en": "Whenever you're ready.", "vi": "Khi nào bạn sẵn sàng cũng được.", "highlights": ["Whenever you're ready"], "note": "Không hối thúc, để người kia chủ động.", "tags": ["reply"] },
  { "id": "soc-082", "topicId": "social", "en": "Sorry I'm late.", "vi": "Xin lỗi tôi đến trễ.", "highlights": ["Sorry I'm late"], "note": "Xin lỗi khi tới muộn.", "tags": ["polite"] },
  { "id": "soc-083", "topicId": "social", "en": "I didn't mean it that way.", "vi": "Tôi không có ý đó đâu.", "highlights": ["didn't mean it that way"], "note": "Đính chính khi bị hiểu nhầm.", "tags": ["polite"] },
  { "id": "soc-084", "topicId": "social", "en": "It's totally fine.", "vi": "Không sao đâu mà.", "highlights": ["totally fine"], "note": "Trấn an, bỏ qua chuyện nhỏ.", "tags": ["reply"] },
  { "id": "soc-085", "topicId": "social", "en": "Good to see you!", "vi": "Gặp bạn vui quá!", "highlights": ["Good to see you"], "note": "Chào khi gặp mặt (thân mật, ấm áp).", "tags": ["greeting"] },
  { "id": "soc-086", "topicId": "social", "en": "Welcome back!", "vi": "Chào mừng trở lại!", "highlights": ["Welcome back"], "note": "Chào ai đó sau khi họ đi vắng về.", "tags": ["greeting"] },
  { "id": "soc-087", "topicId": "social", "en": "Long week, huh?", "vi": "Tuần này dài ghê nhỉ?", "highlights": ["Long week"], "note": "Small talk đồng cảm về tuần bận rộn.", "tags": ["small talk"] },
  { "id": "soc-088", "topicId": "social", "en": "How do you two know each other?", "vi": "Hai bạn quen nhau thế nào?", "highlights": ["know each other"], "note": "Câu làm quen trong buổi gặp đông người.", "tags": ["small talk"] },
  { "id": "soc-089", "topicId": "social", "en": "What do you do?", "vi": "Bạn làm nghề gì?", "highlights": ["What do you do"], "note": "Hỏi nghề nghiệp khi mới quen.", "tags": ["small talk"] },
  { "id": "soc-090", "topicId": "social", "en": "Where are you from?", "vi": "Bạn quê ở đâu?", "highlights": ["Where are you from"], "note": "Câu làm quen cơ bản.", "tags": ["small talk"] },
  { "id": "soc-091", "topicId": "social", "en": "That's hilarious.", "vi": "Hài thật đấy.", "highlights": ["hilarious"], "note": "'hilarious' = rất buồn cười. Phản ứng khi nghe chuyện vui.", "tags": ["small talk"] },
  { "id": "soc-092", "topicId": "social", "en": "No way!", "vi": "Trời, thật không!", "highlights": ["No way"], "note": "Phản ứng ngạc nhiên/khó tin.", "tags": ["small talk"] },
  { "id": "soc-093", "topicId": "social", "en": "Are you serious?", "vi": "Bạn nói thật à?", "highlights": ["Are you serious"], "note": "Ngạc nhiên, muốn xác nhận.", "tags": ["small talk"] },
  { "id": "soc-094", "topicId": "social", "en": "I had no idea.", "vi": "Tôi chẳng hề hay biết.", "highlights": ["had no idea"], "note": "Bày tỏ bất ngờ vì không biết trước.", "tags": ["small talk"] },
  { "id": "soc-095", "topicId": "social", "en": "That makes two of us.", "vi": "Vậy là cả hai mình giống nhau rồi.", "highlights": ["makes two of us"], "note": "Đồng cảm: 'tôi cũng vậy'.", "tags": ["small talk"] },
  { "id": "soc-096", "topicId": "social", "en": "I feel the same way.", "vi": "Tôi cũng cảm thấy y vậy.", "highlights": ["feel the same way"], "note": "Đồng cảm về cảm xúc/quan điểm.", "tags": ["small talk"] },
  { "id": "soc-097", "topicId": "social", "en": "Let's keep it casual.", "vi": "Mình cứ thoải mái thôi nhé.", "highlights": ["keep it casual"], "note": "Đề nghị không trang trọng, tự nhiên.", "tags": ["invitation"] },
  { "id": "soc-098", "topicId": "social", "en": "I'm just kidding.", "vi": "Tôi đùa thôi mà.", "highlights": ["just kidding"], "note": "Nói rõ là đang đùa, tránh hiểu lầm.", "tags": ["small talk"] },
  { "id": "soc-099", "topicId": "social", "en": "Anytime!", "vi": "Có gì đâu, lúc nào cũng được!", "highlights": ["Anytime"], "note": "Đáp lời cảm ơn kiểu 'sẵn lòng'.", "tags": ["reply"] },
  { "id": "soc-100", "topicId": "social", "en": "Catch you later.", "vi": "Hẹn gặp lại sau nhé.", "highlights": ["Catch you later"], "note": "Tạm biệt thân mật, kiểu 'gặp sau'.", "tags": ["greeting"] }
]
